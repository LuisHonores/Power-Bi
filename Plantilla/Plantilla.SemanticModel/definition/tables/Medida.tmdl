	measure 'TML Football Events' =
			
			
			VAR _ventas_acum = [Venta Neta]
			VAR _variacion   = [VAR Ventas Netas PY]
			VAR _fmt_acum    = FORMAT(_ventas_acum,"#,##0")
			VAR _fmt_var     = FORMAT(ABS(_variacion), "0.00") & "%"
			VAR _sign        = IF(_variacion >= 0, "+", "-")
			VAR _color_var   = IF(_variacion >= 0, "#08C792", "#ED2939")
			
			VAR _sales_array =
			    CONCATENATEX(
			        CALCULATETABLE(
			            ADDCOLUMNS(
			                VALUES(DimDate[YearMonth]),
			                "_v", [Venta Neta]
			            ),
			            ALLSELECTED(DimDate)
			        ),
			        [_v],
			        ",",
			        DimDate[YearMonth],
			        ASC
			    )
			
			VAR _labels_array =
			    CONCATENATEX(
			        CALCULATETABLE(
			            VALUES(DimDate[YearMonth]),
			            ALLSELECTED(DimDate)
			        ),
			        "'" & DimDate[YearMonth] & "'",
			        ",",
			        DimDate[YearMonth],
			        ASC
			    )
			
			RETURN
			
			"<!DOCTYPE html><html lang='es'><head><meta charset='UTF-8'>" &
			"<style>" &
			"*{box-sizing:border-box;margin:0;padding:0}" &
			"html,body{width:1069px;height:577px;overflow:hidden;font-family:'Segoe UI',sans-serif;background:#F6F7F9}" &
			".hdr{display:flex;align-items:flex-end;justify-content:space-between;padding:13px 24px 11px;border-bottom:1px solid #E5E7EB;background:#F6F7F9;height:72px}" &
			".kpi-row{display:flex;gap:0}" &
			".kpi{display:flex;flex-direction:column;gap:1px;padding:0 20px}" &
			".kpi:first-child{padding-left:0}" &
			".kpi+.kpi{border-left:1px solid #E5E7EB}" &
			".kl{font-size:9px;color:#9CA3AF;letter-spacing:0.09em;text-transform:uppercase}" &
			".kv{font-size:21px;font-weight:300;color:#1F2937;letter-spacing:-0.02em;line-height:1.2}" &
			".kd{font-size:10px;font-weight:600;margin-top:1px}" &
			".ks{font-size:9px;color:#9CA3AF}" &
			".pt{font-size:9px;color:#B0B8C4;letter-spacing:0.07em;text-transform:uppercase;text-align:right;line-height:1.9}" &
			".ca{position:relative;width:1069px;height:468px}" &
			"canvas{position:absolute;top:0;left:0}" &
			".ft{display:flex;gap:18px;align-items:center;padding:6px 24px;border-top:0.5px solid #E5E7EB;height:37px}" &
			".lg{display:flex;align-items:center;gap:6px;font-size:9px;color:#9CA3AF;letter-spacing:0.04em}" &
			".ll{width:20px;height:1.5px;background:#2F9BC4}" &
			".lc{width:7px;height:7px;border-radius:50%;border:1px solid #1F2937;background:#fff}" &
			".tt{position:absolute;pointer-events:none;opacity:0;transition:opacity 0.15s;background:#1F2937;border:0.5px solid #374151;padding:10px 13px;width:224px;z-index:50}" &
			".tt.show{opacity:1}" &
			".tt-dt{font-size:9px;color:#6B7280;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:3px}" &
			".tt-nm{font-size:11px;font-weight:600;color:#F9FAFB;line-height:1.35;margin-bottom:5px}" &
			".tt-ds{font-size:10px;color:#9CA3AF;line-height:1.58}" &
			".tt-sl{font-size:10px;color:#48B8DE;margin-top:6px;font-weight:500}" &
			".tt-bg{display:inline-block;margin-top:6px;font-size:8px;font-weight:700;letter-spacing:0.09em;color:#185FA5;background:#EAF6FB;padding:2px 7px;text-transform:uppercase}" &
			"</style></head><body>" &
			
			"<div class='hdr'>" &
			  "<div class='kpi-row'>" &
			    "<div class='kpi'><span class='kl'>Ventas acumuladas</span><span class='kv'>USD " & _fmt_acum & "</span><span class='kd' style='color:" & _color_var & "'>" & _sign & _fmt_var & " vs período ant.</span></div>" &
			    "<div class='kpi'><span class='kl'>Pico identificado</span><span class='kv'>Ago 2025</span><span class='ks'>League Start New Kits</span></div>" &
			    "<div class='kpi'><span class='kl'>Categorías de eventos</span><span class='kv'>29</span><span class='ks'>2021 – 2025</span></div>" &
			  "</div>" &
			  "<div class='pt'>Enero 2021 – Diciembre 2025</div>" &
			"</div>" &
			
			"<div class='ca'>" &
			  "<canvas id='sc' width='1069' height='468' aria-label='Ventas Netas con eventos de fútbol 2021-2025'></canvas>" &
			  "<div class='tt' id='tt'><div class='tt-dt' id='tt-d'></div><div class='tt-nm' id='tt-n'></div><div class='tt-ds' id='tt-s'></div><div class='tt-sl' id='tt-v'></div><div class='tt-bg' id='tt-b'></div></div>" &
			"</div>" &
			
			"<div class='ft'>" &
			  "<div class='lg'><div class='ll'></div>Ventas Netas mensuales</div>" &
			  "<div class='lg'><div class='lc'></div>Evento comercial — pasa el cursor sobre el marcador</div>" &
			"</div>" &
			
			"<script src='https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js'></script>" &
			"<script>(function(){" &
			
			"var LB=[" & _labels_array & "];" &
			"var SL=[" & _sales_array & "];" &
			
			"var EV={" &
			"4:{s:'Finals & Trophies',d:'May 2021',n:'Finals and Trophies — May 2021',t:'Cierre de temporada con finales de grandes ligas y entrega de trofeos. Pico de demanda en camisetas de equipos campeones y colecciones conmemorativas.',b:'FINALS & TROPHIES'}," &
			"7:{s:'League Start',d:'Ago 2021',n:'League Start & New Kits — Ago 2021',t:'Inicio de temporada 2021-22. Lanzamiento de nuevas equipaciones oficiales. Alta rotación de producto en categoría jerseys y kits infantiles.',b:'LEAGUE START · NEW KITS'}," &
			"8:{s:'New Kits',d:'Sep 2021',n:'New Kits — Sep 2021',t:'Segunda ola de lanzamientos de kits. Equipos de primera división presentan uniformes alternos. Demanda sostenida en el canal digital.',b:'LEAGUE START · NEW KITS'}," &
			"10:{s:'Holiday',d:'Nov 2021',n:'Holiday & Gifting — Nov 2021',t:'Inicio de temporada navideña. Campañas de regalo deportivo. Los jerseys y kits se posicionan como el regalo preferido en categoría deporte.',b:'HOLIDAY & GIFTING'}," &
			"11:{s:'Gifting',d:'Dic 2021',n:'Holiday & Gifting — Dic 2021',t:'Pico de ventas navideñas. Mayor volumen de pedidos de regalo en indumentaria deportiva. Efecto Black Friday extendido hacia Navidad.',b:'HOLIDAY & GIFTING'}," &
			"16:{s:'Finals & Trophies',d:'May 2022',n:'Finals and Trophies — May 2022',t:'Finales de temporada 2022. Grandes definiciones en Champions League y ligas top. Demanda concentrada en jerseys de equipos finalistas.',b:'FINALS & TROPHIES'}," &
			"17:{s:'Global Cup',d:'Jun 2022',n:'Global Cup 2022 — Fase de Grupos',t:'Inicio del ciclo Global Cup 2022. Expectativa máxima en mercados LATAM y Europa. Ventas de indumentaria de selecciones nacionales en alza.',b:'GLOBAL CUP 2022'}," &
			"18:{s:'Global Cup Final',d:'Jul 2022',n:'Global Cup 2022 — Etapa Final',t:'Etapa decisiva del Global Cup 2022. Pico de audiencia y demanda de producto oficial. Alta correlación con ventas de camisetas de selecciones finalistas.',b:'GLOBAL CUP 2022'}," &
			"19:{s:'League Start',d:'Ago 2022',n:'League Start & New Kits — Ago 2022',t:'Arranque de temporada 2022-23. Nuevas equipaciones de los grandes clubes europeos. Récord de pre-ventas en categoría kits.',b:'LEAGUE START · NEW KITS'}," &
			"20:{s:'New Kits',d:'Sep 2022',n:'New Kits — Sep 2022',t:'Lanzamientos complementarios de kits. Alta demanda en mercados donde el fútbol vive su temporada alta.',b:'LEAGUE START · NEW KITS'}," &
			"22:{s:'Holiday',d:'Nov 2022',n:'Holiday & Gifting — Nov 2022',t:'Temporada de regalos con efecto multiplicador del Global Cup. Doble impacto en ventas: navidad + torneo internacional en curso.',b:'HOLIDAY & GIFTING'}," &
			"23:{s:'Gifting',d:'Dic 2022',n:'Holiday & Gifting — Dic 2022',t:'Cierre del año con el mayor volumen de ventas del período. Efecto post-torneo sostenido más campaña navideña. Pico histórico de la categoría.',b:'HOLIDAY & GIFTING'}," &
			"28:{s:'Finals & Trophies',d:'May 2023',n:'Finals and Trophies — May 2023',t:'Finales de temporada 2022-23. Grandes definiciones en Champions League y ligas top. Demanda concentrada en jerseys de equipos finalistas.',b:'FINALS & TROPHIES'}," &
			"31:{s:'League Start',d:'Ago 2023',n:'League Start & New Kits — Ago 2023',t:'Inicio de temporada 2023-24. Fichajes estrella generan expectativa en nuevas camisetas. Lanzamientos más anticipados de los últimos años.',b:'LEAGUE START · NEW KITS'}," &
			"32:{s:'New Kits',d:'Sep 2023',n:'New Kits — Sep 2023',t:'Segunda oleada de kits de temporada. Fuerte activación digital y en punto de venta. Alta conversión en segmento juvenil.',b:'LEAGUE START · NEW KITS'}," &
			"34:{s:'Holiday',d:'Nov 2023',n:'Holiday & Gifting — Nov 2023',t:'Pre-campaña navideña con catálogo renovado. Los kits de la nueva temporada son el producto estrella de la temporada de regalos.',b:'HOLIDAY & GIFTING'}," &
			"35:{s:'Gifting',d:'Dic 2023',n:'Holiday & Gifting — Dic 2023',t:'Pico navideño 2023. Crecimiento sostenido respecto al año anterior. La indumentaria deportiva consolida su lugar como categoría líder en regalos.',b:'HOLIDAY & GIFTING'}," &
			"40:{s:'Finals & Trophies',d:'May 2024',n:'Finals and Trophies — May 2024',t:'Finales de la temporada 2023-24. Champions League y ligas europeas con alta audiencia. Ventas de jerseys de campeones con pico post-final.',b:'FINALS & TROPHIES'}," &
			"41:{s:'Cont. Championship',d:'Jun 2024',n:'Continental Championship 2024 — Fase Inicial',t:'Inicio del Continental Championship 2024. Doble impacto con cierre de temporada. Alta demanda de camisetas de selecciones participantes en LATAM y Europa.',b:'CONTINENTAL CHAMP.'}," &
			"42:{s:'Cont. Champ. Final',d:'Jul 2024',n:'Continental Championship 2024 — Etapa Final',t:'Definición del Continental Championship 2024. Pico máximo de audiencia del torneo. Ventas de indumentaria de selecciones finalistas en máximos del año.',b:'CONTINENTAL CHAMP.'}," &
			"43:{s:'League Start',d:'Ago 2024',n:'League Start & New Kits — Ago 2024',t:'Arranque de temporada 2024-25. Nuevas equipaciones con alta inversión en diseño. Pre-ventas digitales superan registros anteriores.',b:'LEAGUE START · NEW KITS'}," &
			"44:{s:'New Kits',d:'Sep 2024',n:'New Kits — Sep 2024',t:'Lanzamientos de kits alternos y terceras equipaciones. Fuerte presencia en canales digitales y activaciones en tienda.',b:'LEAGUE START · NEW KITS'}," &
			"46:{s:'Holiday',d:'Nov 2024',n:'Holiday & Gifting — Nov 2024',t:'Temporada de regalos 2024. Campañas integradas on/off. Los kits de temporada y colecciones especiales navideñas lideran el mix de ventas.',b:'HOLIDAY & GIFTING'}," &
			"47:{s:'Gifting',d:'Dic 2024',n:'Holiday & Gifting — Dic 2024',t:'Cierre del año con fuerte performance en categoría indumentaria. Efecto acumulado del Continental Championship sostenido hacia la temporada navideña.',b:'HOLIDAY & GIFTING'}," &
			"52:{s:'Finals & Trophies',d:'May 2025',n:'Finals and Trophies — May 2025',t:'Finales de temporada 2024-25. Alta expectativa con definiciones en Champions League. Ventas de producto oficial en máximos de la ventana de playoffs.',b:'FINALS & TROPHIES'}," &
			"55:{s:'League Start',d:'Ago 2025',n:'League Start & New Kits — Ago 2025',t:'Inicio de temporada 2025-26. Ambiente de antesala al Mundial 2026. Los lanzamientos de kits incorporan elementos alusivos al torneo próximo.',b:'LEAGUE START · NEW KITS'}," &
			"56:{s:'New Kits',d:'Sep 2025',n:'New Kits — Sep 2025',t:'Segunda ola de equipaciones 2025-26. Fuerte tracción en mercados de EE.UU., México y Canadá de cara al Mundial 2026.',b:'LEAGUE START · NEW KITS'}," &
			"58:{s:'Holiday',d:'Nov 2025',n:'Holiday & Gifting — Nov 2025',t:'Temporada navideña 2025 con efecto anticipatorio del Mundial 2026. Demanda de indumentaria de selecciones nacionales en aumento sostenido.',b:'HOLIDAY & GIFTING'}," &
			"59:{s:'Gifting',d:'Dic 2025',n:'Holiday & Gifting — Dic 2025',t:'Cierre del período analizado. Pico navideño 2025 con fuerte componente de selecciones nacionales. El mercado anticipa el Mundial 2026 en EE.UU., México y Canadá.',b:'HOLIDAY & GIFTING'}" &
			"};" &
			
			"var EI=Object.keys(EV).map(Number);" &
			
			"var AP={id:'ap',afterDraw:function(C){" &
			"var ctx=C.ctx,X=C.scales.x,Y=C.scales.y;" &
			"var T=C.chartArea.top,L=C.chartArea.left,R=C.chartArea.right;" &
			"var its=[];" &
			"EI.forEach(function(i){" &
			"if(i>=LB.length)return;" &
			"ctx.font='500 8px Segoe UI,sans-serif';" &
			"var tx=EV[i].s,tw=ctx.measureText(tx).width+12;" &
			"its.push({i:i,xp:X.getPixelForValue(i),yp:Y.getPixelForValue(SL[i]||0),tx:tx,tw:tw});" &
			"});" &
			"var BH=13,GP=2,pl=[];" &
			"its.forEach(function(p){" &
			"var bw=p.tw,bx=p.xp-bw/2;" &
			"if(bx<L+1)bx=L+1;" &
			"if(bx+bw>R-1)bx=R-1-bw;" &
			"var rw=0,ok=false;" &
			"while(!ok&&rw<5){ok=true;" &
			"for(var k=0;k<pl.length;k++){var q=pl[k];if(q.rw===rw&&bx<q.bx+q.bw+5&&bx+bw>q.bx){ok=false;break;}}" &
			"if(!ok)rw++;}" &
			"var by=T+2+rw*(BH+GP);" &
			"pl.push({bx:bx,bw:bw,rw:rw});" &
			"ctx.save();" &
			"ctx.beginPath();ctx.setLineDash([1,4]);ctx.strokeStyle='rgba(47,155,196,0.16)';ctx.lineWidth=0.7;" &
			"ctx.moveTo(p.xp,by+BH);ctx.lineTo(p.xp,p.yp-7);ctx.stroke();ctx.setLineDash([]);" &
			"ctx.fillStyle='#FFFFFF';ctx.strokeStyle='#D1D9E0';ctx.lineWidth=0.5;" &
			"ctx.beginPath();ctx.rect(bx,by,bw,BH);ctx.fill();ctx.stroke();" &
			"ctx.beginPath();ctx.moveTo(bx,by);ctx.lineTo(bx+bw,by);ctx.strokeStyle='#2F9BC4';ctx.lineWidth=1.2;ctx.stroke();" &
			"ctx.fillStyle='#374151';ctx.font='500 8px Segoe UI,sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';" &
			"ctx.fillText(p.tx,bx+bw/2,by+BH/2);" &
			"ctx.restore();" &
			"});" &
			"}};" &
			
			"function build(){" &
			"var cv=document.getElementById('sc');" &
			"if(!cv||typeof Chart==='undefined')return;" &
			"if(cv._ch){cv._ch.destroy();}" &
			"var ED=SL.map(function(v,i){return EI.indexOf(i)>=0?v:null;});" &
			"var g=cv.getContext('2d').createLinearGradient(0,0,0,468);" &
			"g.addColorStop(0,'rgba(47,155,196,0.11)');g.addColorStop(0.65,'rgba(47,155,196,0.02)');g.addColorStop(1,'rgba(47,155,196,0)');" &
			"cv._ch=new Chart(cv,{type:'line'," &
			"data:{labels:LB,datasets:[" &
			"{label:'Ventas',data:SL,borderColor:'#2F9BC4',borderWidth:1.7,backgroundColor:g,fill:true,tension:0.40," &
			"pointRadius:SL.map(function(_,i){return EI.indexOf(i)>=0?0:1.5;}),pointBackgroundColor:'#2F9BC4',pointBorderColor:'#2F9BC4',pointBorderWidth:0,pointHoverRadius:3,order:2}," &
			"{label:'Ev',data:ED,type:'line',showLine:false," &
			"pointRadius:6,pointHoverRadius:8," &
			"pointBackgroundColor:'#FFFFFF'," &
			"pointBorderColor:'#1F2937'," &
			"pointBorderWidth:1.2," &
			"pointStyle:'circle',order:1}" &
			"]}," &
			"options:{responsive:false,maintainAspectRatio:false,animation:{duration:400}," &
			"layout:{padding:{top:52,right:16,bottom:18,left:8}}," &
			"plugins:{legend:{display:false},tooltip:{enabled:false}}," &
			"scales:{" &
			"x:{grid:{color:'rgba(229,231,235,0.35)',drawBorder:false}," &
			"ticks:{font:{family:'Segoe UI',size:9},color:'#B0B8C4',maxRotation:0,autoSkip:true,maxTicksLimit:16},border:{display:false}}," &
			"y:{grid:{color:'rgba(229,231,235,0.35)',drawBorder:false},ticks:{display:false},border:{display:false}}" &
			"}}," &
			"plugins:[AP]});" &
			
			"var tt=document.getElementById('tt');" &
			"cv.onmousemove=function(e){" &
			"var pts=cv._ch.getElementsAtEventForMode(e,'nearest',{intersect:true},false);" &
			"if(!pts.length){tt.classList.remove('show');return;}" &
			"var idx=pts[0].index,ds=pts[0].datasetIndex,ev=EV[idx];" &
			"if(ds===1&&ev){" &
			"document.getElementById('tt-d').textContent=ev.d;" &
			"document.getElementById('tt-n').textContent=ev.n;" &
			"document.getElementById('tt-s').textContent=ev.t;" &
			"document.getElementById('tt-v').textContent='Ventas ese mes: S/ '+(SL[idx]||0).toLocaleString('es-PE');" &
			"document.getElementById('tt-b').textContent=ev.b;" &
			"tt.classList.add('show');" &
			"var r=cv.getBoundingClientRect(),px=e.clientX-r.left,py=e.clientY-r.top;" &
			"var lx=px+14;if(lx+228>1055)lx=px-238;" &
			"var ly=py-18;if(ly+175>455)ly=py-175;if(ly<4)ly=4;" &
			"tt.style.left=lx+'px';tt.style.top=ly+'px';" &
			"}else tt.classList.remove('show');" &
			"};" &
			"cv.onmouseleave=function(){tt.classList.remove('show');};" &
			"}" &
			
			"function try_build(){" &
			"if(typeof Chart!=='undefined'&&document.getElementById('sc')){build();}" &
			"else{setTimeout(try_build,150);}" &
			"}" &
			
			"if(document.readyState==='loading'){" &
			"document.addEventListener('DOMContentLoaded',function(){setTimeout(try_build,50);});" &
			"}else{" &
			"setTimeout(try_build,50);" &
			"}" &
			
			"document.addEventListener('visibilitychange',function(){" &
			"if(document.visibilityState==='visible')setTimeout(build,100);" &
			"});" &
			
			"})();</script></body></html>"
