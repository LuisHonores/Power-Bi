	measure Html_Resumen =
			
			"<!DOCTYPE html><html lang='es'><head><meta charset='UTF-8'>" &
			"<style>" &
			"*{box-sizing:border-box;margin:0;padding:0}" &
			"html,body{width:1060px;height:173px;overflow:hidden;font-family:'Segoe UI',sans-serif;background:#F6F7F9;color:#1F2937}" &
			".wrap{display:grid;grid-template-columns:auto 1px 1fr 1px 1fr 1px 1fr;height:173px;align-items:stretch}" &
			".col{padding:14px 18px;display:flex;flex-direction:column;justify-content:center;gap:5px}" &
			".div{background:#E5E7EB;width:1px;margin:14px 0}" &
			".label{font-size:8px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#9CA3AF;margin-bottom:2px}" &
			".title-block{padding:14px 20px 14px 18px;display:flex;flex-direction:column;justify-content:center;gap:3px;min-width:170px}" &
			".title{font-size:12px;font-weight:600;color:#1F2937}" &
			".period{font-size:9px;color:#9CA3AF}" &
			".badge{margin-top:6px;font-size:8px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:2px 7px;border-radius:2px;background:#EAF6FB;color:#185FA5;display:inline-block;width:fit-content}" &
			".body{font-size:10.5px;color:#374151;line-height:1.7}" &
			".hl{font-weight:600;color:#1F2937}" &
			".ac{color:#2F9BC4;font-weight:600}" &
			".up{color:#08C792;font-weight:600}" &
			".dn{color:#ED2939;font-weight:600}" &
			"</style></head><body>" &
			"<div class='wrap'>" &
			
			"<div class='title-block'>" &
			"<div class='title'>Ranking Ejecutivo</div>" &
			"<div class='period'>Ventas Netas 2025</div>" &
			"<div class='badge'>Dirección General</div>" &
			"</div>" &
			
			"<div class='div'></div>" &
			
			"<div class='col'>" &
			"<div class='label'>Canales</div>" &
			"<div class='body'><span class='hl'>Web</span> lidera volumen con <span class='ac'>S/ 1.33M</span> y <span class='ac'>52.9%</span> de margen. <span class='hl'>Mobile App</span> alcanza <span class='ac'>S/ 1.26M</span> con margen superior (<span class='ac'>53.2%</span>), evidenciando mayor eficiencia transaccional. Distribución equilibrada entre canales reduce riesgo de concentración.</div>" &
			"</div>" &
			
			"<div class='div'></div>" &
			
			"<div class='col'>" &
			"<div class='label'>Categorías</div>" &
			"<div class='body'><span class='hl'>Kits</span> (<span class='ac'>S/ 1.02M</span>) y <span class='hl'>Footwear</span> (<span class='ac'>S/ 921k</span>) concentran el volumen. <span class='hl'>Collectibles</span> destaca con el mayor margen (<span class='up'>57.0%</span>) y potencial premium. <span class='hl'>Training Equipment</span> requiere revisión: margen más bajo del portafolio (<span class='dn'>48.6%</span>).</div>" &
			"</div>" &
			
			"<div class='div'></div>" &
			
			"<div class='col'>" &
			"<div class='label'>Mercados</div>" &
			"<div class='body'><span class='hl'>EE.UU.</span> (<span class='up'>57.9%</span>), <span class='hl'>Japan</span> (<span class='up'>55.9%</span>) y <span class='hl'>UK</span> (<span class='ac'>53.7%</span>) lideran rentabilidad. <span class='hl'>Mexico</span> (<span class='dn'>47.4%</span>) y <span class='hl'>Australia</span> (<span class='dn'>48.7%</span>) operan bajo el umbral promedio y requieren intervención en precio o mix de producto.</div>" &
			"</div>" &
			
			"</div>" &
			"</body></html>"
		lineageTag: 590bdb45-2c0f-451f-a54c-0703f41a27ba

