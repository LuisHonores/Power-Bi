			"
			
			```
		lineageTag: 9dd78904-a914-448d-8ead-a8acbc2959d2

	measure 'HTML Football Events' = ```
			
			VAR _ventas_acum = [Venta Neta]
			VAR _variacion   = [VAR Margen]
			VAR _fmt_acum    = FORMAT(_ventas_acum, "#,##0")
			VAR _fmt_var     = FORMAT(ABS(_variacion), "0.00") & "%"
			VAR _sign        = IF(_variacion >= 0, "+", "-")
			VAR _color_var   = IF(_variacion >= 0, "#08C792", "#ED2939")
			
			VAR _sales_array =
			    CONCATENATEX(
			        CALCULATETABLE(
			            ADDCOLUMNS(
			                VALUES(DimDate[YearMonth]),
			                "_v", [Venta Neta]
			            ),
			            ALLSELECTED(DimDate)
			        ),
			        [_v],
			        ",",
			        DimDate[YearMonth], ASC
			    )
			
			VAR _labels_array =
			    CONCATENATEX(
			        CALCULATETABLE(
			            VALUES(DimDate[YearMonth]),
			            ALLSELECTED(DimDate)
			        ),
			        "'" & DimDate[YearMonth] & "'",
			        ",",
			        DimDate[YearMonth], ASC
			    )
			
			RETURN
			
			"<style>" &
			"*{box-sizing:border-box;margin:0;padding:0}" &
			"body{font-family:'Segoe UI',sans-serif;background:#F6F7F9;padding:24px 28px}" &
			".top-bar{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:22px;padding-bottom:16px;border-bottom:1px solid #E5E7EB}" &
			".kpi-row{display:flex;gap:28px}" &
			".kpi{display:flex;flex-direction:column;gap:2px}" &
			".kpi-label{font-size:10px;color:#9CA3AF;letter-spacing:0.08em;text-transform:uppercase}" &
			".kpi-val{font-size:24px;font-weight:300;color:#1F2937;letter-spacingrequestAnimationFrame:-0.03em}" &
			".kpi-delta{font-size:11px;font-weight:500}" &
			".kpi-sub{font-size:10px;color:#9CA3AF;margin-top:1px}" &
			".sep{width:1px;background:#E5E7EB;height:38px;align-self:flex-end}" &
			".period-tag{font-size:10px;color:#B0B8C4;letter-spacing:0.06em;text-transform:uppercase;text-align:right;line-height:1.8}" &
			".chart-wrap{position:relative;width:100%;height:310px}" &
			".legend-row{display:flex;gap:20px;align-items:center;margin-top:12px;padding-top:10px;border-top:0.5px solid #E5E7EB}" &
			".leg{display:flex;align-items:center;gap:7px;font-size:10px;color:#9CA3AF;letter-spacing:0.04em}" &
			".leg-line{width:22px;height:1.5px;background:#2F9BC4}" &
			".leg-diamond{width:8px;height:8px;background:#1F2937;transform:rotate(45deg)}" &
			".leg-hint{margin-left:auto;font-size:10px;color:#D1D8E0;letter-spacing:0.03em}" &
			".ann-panel{margin-top:18px;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px}" &
			".ann-card{background:#FFFFFF;border:0.5px solid #E9ECF0;border-top:2px solid #2F9BC4;padding:14px 16px 15px}" &
			".ann-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:5px}" &
			".ann-name{font-size:12px;font-weight:600;color:#1F2937;line-height:1.35}" &
			".ann-date{font-size:10px;color:#9CA3AF;letter-spacing:0.06em;white-space:nowrap;margin-left:8px;flex-shrink:0}" &
			".ann-body{font-size:11px;color:#6B7280;line-height:1.68}" &
			".ann-badge{display:inline-block;margin-top:9px;font-size:9px;font-weight:600;letter-spacing:0.09em;color:#185FA5;background:#EAF6FB;padding:2px 9px;text-transform:uppercase}" &
			"</style>" &
			
			"<div class='top-bar'>" &
			  "<div class='kpi-row'>" &
			    "<div class='kpi'>" &
			      "<span class='kpi-label'>Ventas acumuladas</span>" &
			      "<span class='kpi-val'>S/ " & _fmt_acum & "</span>" &
			      "<span class='kpi-delta' style='color:" & _color_var & "'>" & _sign & _fmt_var & " vs período ant.</span>" &
			    "</div>" &
			    "<div class='sep'></div>" &
			    "<div class='kpi'>" &
			      "<span class='kpi-label'>Pico de ventas</span>" &
			      "<span class='kpi-val'>Nov 2022</span>" &
			      "<span class='kpi-sub'>Copa del Mundo Qatar</span>" &
			    "</div>" &
			    "<div class='sep'></div>" &
			    "<div class='kpi'>" &
			      "<span class='kpi-label'>Eventos identificados</span>" &
			      "<span class='kpi-val'>5</span>" &
			      "<span class='kpi-sub'>Eventos de fútbol global</span>" &
			    "</div>" &
			  "</div>" &
			  "<div class='period-tag'>Enero 2021 – Setiembre 2023</div>" &
			"</div>" &
			
			"<div class='chart-wrap'>" &
			  "<canvas id='sc' role='img' aria-label='Ventas mensuales con eventos de fútbol marcados.'>" &
			    "Gráfico de ventas con hitos de fútbol global." &
			  "</canvas>" &
			"</div>" &
			
			"<div class='legend-row'>" &
			  "<div class='leg'><div class='leg-line'></div>Ventas mensuales</div>" &
			  "<div class='leg'><div class='leg-diamond'></div>Evento de fútbol global</div>" &
			  "<span class='leg-hint'>Etiquetas de evento visibles sobre el gráfico</span>" &
			"</div>" &
			
			"<div class='ann-panel' id='annPanel'></div>" &
			
			"<script src='https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js'></script>" &
			"<script>" &
			
			"var labels=[" & _labels_array & "];" &
			"var sales=[" & _sales_array & "];" &
			
			"var events={" &
			  "5:{short:'Copa América 2021',date:'Jun 2021',name:'Copa América — Brasil 2021',desc:'Torneo continental disputado en Brasil. Argentina campeón por primera vez en 28 años liderado por Messi. +500M espectadores acumulados en TV y plataformas digitales a nivel global.',badge:'CONMEBOL · Copa América'}," &
