table Medida
	lineageTag: 025920f2-2394-4ec1-9d85-59d97df26149

	measure HTML_Caratula_1920 =
			
			VAR _Ventas       = [Venta Neta AA]
			VAR _Margen       = [Margen]
			VAR _VarV         = [VAR Ventas Netas PY]
			VAR _VarM         = [VAR Margen]
			
			VAR _VentasFmt    = FORMAT(_Ventas,         "$#,0")
			VAR _MargenFmt    = FORMAT(_Margen,         "0.0%")
			VAR _VarVFmt      = FORMAT(ABS(_VarV),      "0.00%")
			VAR _VarMFmt      = FORMAT(ABS(_VarM),      "0.000")
			
			VAR _AV  = IF(_VarV >= 0, "▲", "▼")
			VAR _CV  = IF(_VarV >= 0, "#08C792", "#ED2939")
			VAR _BV  = IF(_VarV >= 0, "rgba(8,199,146,.13)",  "rgba(237,41,57,.13)")
			VAR _BVB = IF(_VarV >= 0, "rgba(8,199,146,.22)",  "rgba(237,41,57,.22)")
			
			VAR _AM  = IF(_VarM >= 0, "▲", "▼")
			VAR _CM  = IF(_VarM >= 0, "#08C792", "#ED2939")
			VAR _BM  = IF(_VarM >= 0, "rgba(8,199,146,.13)",  "rgba(237,41,57,.13)")
			VAR _BMB = IF(_VarM >= 0, "rgba(8,199,146,.22)",  "rgba(237,41,57,.22)")
			
			RETURN
			"<html><head><meta charset='UTF-8'><style>
			*{box-sizing:border-box;margin:0;padding:0;}
			html{width:100%;height:100%;}
			body{width:100vw;height:100vh;overflow:hidden;background:#0d1b2e;display:block;}
			.wrapper{width:100vw;height:100vh;display:flex;align-items:center;justify-content:center;overflow:hidden;}
			.cover{width:1920px;height:1080px;transform-origin:top left;font-family:'Segoe UI',sans-serif;background:radial-gradient(ellipse at 30% 50%,#112240 0%,#0d1b2e 60%);position:relative;overflow:hidden;display:flex;flex-direction:row;align-items:stretch;}
			.sweep{position:absolute;inset:0;background:linear-gradient(115deg,transparent 35%,rgba(72,184,222,.05) 50%,transparent 65%);background-size:300% 100%;animation:sweep 5s ease-in-out infinite;}
			@keyframes sweep{0%,100%{background-position:200% 0;}50%{background-position:-100% 0;}}
			.field{position:absolute;inset:0;opacity:.07;}
			.field svg{width:100%;height:100%;}
			.accent-bar{position:absolute;top:0;bottom:0;left:0;width:4px;z-index:10;background:linear-gradient(180deg,transparent,#48B8DE 30%,#4872A5 70%,transparent);background-size:100% 300%;animation:barScroll 3s linear infinite;}
			@keyframes barScroll{0%{background-position:0 100%;}100%{background-position:0 -200%;}}
			.sep{position:absolute;top:8%;bottom:8%;left:44%;width:1px;z-index:3;background:linear-gradient(180deg,transparent,rgba(72,184,222,.35) 20%,rgba(72,184,222,.35) 80%,transparent);animation:sepPulse 3s ease-in-out infinite;}
			@keyframes sepPulse{0%,100%{opacity:.4;}50%{opacity:1;}}
			.orb{position:absolute;border-radius:50%;filter:blur(60px);animation:orbPulse 4s ease-in-out infinite;}
			.orb1{width:420px;height:420px;top:-80px;right:60px;background:rgba(72,184,222,.07);}
			.orb2{width:280px;height:280px;bottom:-60px;right:200px;background:rgba(72,130,165,.08);animation-delay:2s;}
			@keyframes orbPulse{0%,100%{opacity:.6;}50%{opacity:1;}}
			.particle{position:absolute;border-radius:50%;background:#48B8DE;}
			.pa{width:4px;height:4px;top:18%;left:47%;opacity:.35;animation:float 5s ease-in-out infinite;}
			.pb{width:3px;height:3px;top:70%;left:62%;opacity:.25;animation:float 5s ease-in-out 1.3s infinite;}
			.pc{width:6px;height:6px;top:32%;left:85%;opacity:.28;animation:float 5s ease-in-out 2.1s infinite;}
			.pd{width:3px;height:3px;top:80%;left:78%;opacity:.2;animation:float 5s ease-in-out .7s infinite;}
			.pe{width:5px;height:5px;top:12%;left:72%;opacity:.22;animation:float 5s ease-in-out 3s infinite;}
			@keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-18px);}}
			.ring{position:absolute;border-radius:50%;border:1px solid rgba(72,184,222,.07);animation:ringPulse 5s ease-in-out infinite;}
			.r1{width:380px;height:380px;top:-100px;right:40px;}
			.r2{width:240px;height:240px;top:-40px;right:100px;animation-delay:1.5s;}
			.r3{width:160px;height:160px;top:10px;right:160px;animation-delay:2.5s;}
			@keyframes ringPulse{0%,100%{opacity:.4;transform:scale(1);}50%{opacity:.9;transform:scale(1.03);}}
			.left-panel{position:relative;z-index:4;width:44%;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:80px 70px 80px 90px;}
			.right-panel{position:relative;z-index:4;flex:1;display:flex;flex-direction:column;justify-content:center;align-items:stretch;padding:80px 80px 80px 60px;gap:28px;}
			.logo-circle{width:72px;height:72px;border-radius:50%;background:rgba(72,184,222,.1);border:2px solid rgba(72,184,222,.45);display:flex;align-items:center;justify-content:center;flex-shrink:0;position:relative;animation:logoPulse 2.8s ease-in-out infinite;}
			.logo-circle::after{content:'';position:absolute;inset:-6px;border-radius:50%;border:1px solid rgba(72,184,222,.15);}
			@keyframes logoPulse{0%,100%{box-shadow:0 0 0 0 rgba(72,184,222,.3);}50%{box-shadow:0 0 0 12px rgba(72,184,222,0);}}
			.logo-wrap{display:flex;align-items:center;gap:20px;margin-bottom:60px;}
			.brand-name{font-size:30px;font-weight:700;color:#fff;letter-spacing:.5px;}
			.brand-sub{font-size:11px;color:rgba(255,255,255,.38);letter-spacing:2.5px;text-transform:uppercase;margin-top:4px;}
			.live-badge{display:inline-flex;align-items:center;gap:10px;background:rgba(72,184,222,.1);border:1px solid rgba(72,184,222,.28);border-radius:24px;padding:8px 20px;margin-bottom:50px;}
			.live-dot{width:8px;height:8px;border-radius:50%;background:#48B8DE;box-shadow:0 0 6px rgba(72,184,222,.8);animation:blink 1.4s ease-in-out infinite;}
			@keyframes blink{0%,100%{opacity:.2;}50%{opacity:1;box-shadow:0 0 10px rgba(72,184,222,.9);}}
			.live-text{font-size:11px;color:#48B8DE;letter-spacing:2px;text-transform:uppercase;font-weight:500;}
			.h-line{height:1px;width:75%;background:linear-gradient(90deg,#48B8DE,rgba(72,184,222,.2));margin-bottom:40px;}
			.tagline{font-size:15px;color:rgba(255,255,255,.38);line-height:1.75;max-width:340px;}
			.tagline strong{color:rgba(255,255,255,.65);font-weight:500;}
			.year-display{font-size:160px;font-weight:700;color:rgba(255,255,255,.03);line-height:1;letter-spacing:-6px;position:absolute;bottom:4%;left:4%;pointer-events:none;}
			.mcard{background:rgba(255,255,255,.04);border:1px solid rgba(72,184,222,.18);border-radius:16px;padding:36px 42px;position:relative;overflow:hidden;transition:transform .35s,border-color .35s,background .35s;}
			.mcard:hover{transform:translateY(-4px) scale(1.01);border-color:rgba(72,184,222,.55);background:rgba(72,184,222,.09);}
			.mcard::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,#48B8DE,rgba(72,184,222,.25),transparent);}
			.cicon{position:absolute;bottom:16px;right:20px;opacity:.06;transition:opacity .3s;}
			.mcard:hover .cicon{opacity:.14;}
			.card-inner{position:relative;z-index:1;}
			.clabel{font-size:11px;color:rgba(255,255,255,.4);letter-spacing:2px;text-transform:uppercase;margin-bottom:10px;}
			.crow{display:flex;align-items:baseline;gap:12px;}
			.cval{font-size:64px;font-weight:700;color:#fff;line-height:1;letter-spacing:-1.5px;}
			.cunit{font-size:15px;color:#48B8DE;font-weight:400;margin-bottom:4px;}
			.cdelta{display:inline-flex;align-items:center;gap:6px;font-size:13px;padding:5px 16px;border-radius:20px;margin-top:10px;font-weight:500;transition:transform .3s;}
			.mcard:hover .cdelta{transform:translateX(5px);}
			</style></head><body>
			<div class='wrapper'>
			<div class='cover' id='cover'>
			<div class='sweep'></div>
			<div class='orb orb1'></div><div class='orb orb2'></div>
			<div class='field'>
			<svg viewBox='0 0 1920 1080' preserveAspectRatio='xMidYMid slice' xmlns='http://www.w3.org/2000/svg'>
			<rect x='80' y='50' width='1760' height='980' fill='none' stroke='white' stroke-width='2.5'/>
			<line x1='960' y1='50' x2='960' y2='1030' stroke='white' stroke-width='2'/>
			<circle cx='960' cy='540' r='170' fill='none' stroke='white' stroke-width='2'/>
			<circle cx='960' cy='540' r='7' fill='white'/>
			<rect x='80' y='280' width='230' height='520' fill='none' stroke='white' stroke-width='2'/>
			<rect x='1610' y='280' width='230' height='520' fill='none' stroke='white' stroke-width='2'/>
			<rect x='80' y='380' width='100' height='320' fill='none' stroke='white' stroke-width='1.5'/>
			<rect x='1720' y='380' width='100' height='320' fill='none' stroke='white' stroke-width='1.5'/>
			<circle cx='80' cy='540' r='130' fill='none' stroke='white' stroke-width='1.5'/>
			<circle cx='1840' cy='540' r='130' fill='none' stroke='white' stroke-width='1.5'/>
			</svg>
			</div>
			<div class='particle pa'></div><div class='particle pb'></div><div class='particle pc'></div><div class='particle pd'></div><div class='particle pe'></div>
			<div class='ring r1'></div><div class='ring r2'></div><div class='ring r3'></div>
			<div class='accent-bar'></div>
			<div class='sep'></div>
			<div class='left-panel'>
			<div class='logo-wrap'>
			<div class='logo-circle'>
			<svg width='34' height='34' viewBox='0 0 24 24' fill='none'><circle cx='12' cy='12' r='10' stroke='#48B8DE' stroke-width='1.5'/><path d='M12 4L15 9L21 9L16.5 13L18 19L12 15.5L6 19L7.5 13L3 9L9 9Z' fill='#48B8DE' opacity='.9'/></svg>
			</div>
			<div><div class='brand-name'>PitchSide Pro</div><div class='brand-sub'>Global Football Retail</div></div>
			</div>
			<div class='live-badge'><div class='live-dot'></div><span class='live-text'>Performance Dashboard · Live</span></div>
			<div class='h-line'></div>
			<div class='tagline'>Visión ejecutiva de <strong>ventas globales</strong> y <strong>márgenes</strong> </div>
			<div class='year-display'>2024</div>
			</div>
			<div class='right-panel'>
			<div class='mcard'>
			<div class='cicon'><svg width='72' height='72' viewBox='0 0 72 72'><circle cx='36' cy='36' r='34' fill='none' stroke='#48B8DE' stroke-width='1.5'/><path d='M36 12L41 27L57 27L44 36L49 52L36 43L23 52L28 36L15 27L31 27Z' fill='#48B8DE'/></svg></div>
			<div class='card-inner'>
			<div class='clabel'>Ventas Netas 2025</div>
			<div class='crow'><div class='cval'>" & _VentasFmt & "</div><div class='cunit'>USD</div></div>
			<div class='cdelta' style='background:" & _BV & ";color:" & _CV & ";border:1px solid " & _BVB & ";'>" & _AV & " " & _VarVFmt & " vs año anterior</div>
			</div>
			</div>
			<div class='mcard'>
			<div class='cicon'><svg width='72' height='72' viewBox='0 0 72 72'><rect x='8' y='38' width='12' height='26' rx='3' fill='#48B8DE'/><rect x='26' y='24' width='12' height='40' rx='3' fill='#48B8DE'/><rect x='44' y='12' width='12' height='52' rx='3' fill='#48B8DE'/></svg></div>
			<div class='card-inner'>
			<div class='clabel'>Margen Neto 2025</div>
			<div class='crow'><div class='cval'>" & _MargenFmt & "</div></div>
			<div class='cdelta' style='background:" & _BM & ";color:" & _CM & ";border:1px solid " & _BMB & ";'>" & _AM & " " & _VarMFmt & " pp vs año anterior</div>
			</div>
			</div>
			</div>
			</div>
			</div>
			<script>
			(function(){
			  function scale(){
			    var el=document.getElementById('cover');
			    var W=document.documentElement.clientWidth;
			    var H=document.documentElement.clientHeight;
			    if(!W||!H)return;
			    var s=Math.min(W/1920,H/1080);
			    el.style.transform='scale('+s+')';
			    el.style.position='absolute';
			    el.style.top=Math.round((H-1080*s)/2)+'px';
			    el.style.left=Math.round((W-1920*s)/2)+'px';
			  }
			  scale();
			  setTimeout(scale,100);
			  setTimeout(scale,400);
			  window.addEventListener('resize',scale);
			})();
			</script>
			</body></html>"
		lineageTag: 5a354d98-d317-4a73-b991-cb526bff1c80

	measure 'Venta Neta' = SUM(FactSales[NetRevenue])
		lineageTag: 5f586988-2eb9-4b3a-8249-9b51580fed2b

		formatStringDefinition =
				VAR _ValorActual =
				    SELECTEDMEASURE()
				VAR _NumeroFormato =
				    SWITCH (
				        TRUE (),
				        _ValorActual <= 1E3, "#,0.",
				        _ValorActual <= 1E4, "#,0,.00 K",
				        _ValorActual <= 1E5, "#,0,.0 K",
				        _ValorActual <= 1E6, "#,0,. K",
				        _ValorActual <= 1E7, "#,0,,.00 M",
				        _ValorActual <= 1E8, "#,0,,.0 M",
				        _ValorActual <= 1E9, "#,0,,. M"
				    )
				RETURN
				    _NumeroFormato

	measure 'Venta Netas PY' = ```
			
			VAR Inicio_ =   20240101
			VAR Final_ = 20241231
			VAR result =
			CALCULATE ( [Venta Neta] ,DimDate[DateKey] >=  Inicio_  && DimDate[DateKey] <=  Final_ )
			
			RETURN
			result
			
			```
		lineageTag: 9f500ba9-b3d6-4111-aa02-3f957159559e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'VAR Ventas Netas PY' = DIVIDE([Venta Neta AA] - [Venta Netas PY] ,[Venta Netas PY])
		lineageTag: 203cb49a-17b9-4df7-bee0-e5716df01a30

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Utilidad = SUM(FactSales[Profit])
		lineageTag: c7d60979-9744-44c7-817f-85ca2adad5fd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Margen = DIVIDE([UtilidadAA], [Venta Neta AA])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 5797a8a8-07b8-4d4d-baf4-5eb9669b8176

	measure 'Margen PY' =
			
			DIVIDE([UtilidadPY], [Venta Netas PY])
		formatString: 0.0000
		lineageTag: a230424d-477e-4907-8844-30ca8fe7a90d

	measure 'VAR Margen' = DIVIDE([Margen] - [Margen PY] ,[Margen PY])
		lineageTag: 6ff343b6-9167-450c-bacb-3958307a68e1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Leyenda_HTML = ```
			
			"
