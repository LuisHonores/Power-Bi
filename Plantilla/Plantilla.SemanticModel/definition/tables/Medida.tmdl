		formatStringDefinition =
				VAR _ValorActual =
				    SELECTEDMEASURE()
				VAR _NumeroFormato =
				    SWITCH (
				        TRUE (),
				        _ValorActual <= 1E3, "#,0.",
				        _ValorActual <= 1E4, "#,0,.00 K",
				        _ValorActual <= 1E5, "#,0,.0 K",
