	measure HTML_Tabla =
			
			VAR _data =
			    SUMMARIZECOLUMNS(
			        'DimRegion'[Country],
			        'DimRegion'[MacroRegion],
			        'DimProduct'[Category],
			        'DimProduct'[Subcategory],
			        "Ordenes", 'Medida'[TotalOrdener],
			        "Venta Neta", 'Medida'[Venta Neta],
			        "Utilidad",   'Medida'[Utilidad],
			        "Rate",       'Medida'[%Rate],
			        "Ticket",     'Medida'[Ticket Promedio],
			        "Margen",     'Medida'[Margen]
			    )
			
			VAR _maxVenta   = MAXX( _data, [Venta Neta] )
			VAR _maxOrdenes = MAXX( _data, [Ordenes] )
			VAR _maxUtil    = MAXX( _data, [Utilidad] )
			
			VAR _html_inicio = "
			<style>
			  *{box-sizing:border-box;margin:0;padding:0}
			  body{font-family:'Segoe UI',sans-serif;font-size:11px;color:#1F2937;background:#F6F7F9}
			  .wrap{padding:8px;background:#F6F7F9}
			  table{width:100%;border-collapse:collapse;table-layout:fixed}
			  th{text-align:left;font-weight:700;font-size:11px;color:#1F2937;
			     padding:7px 10px;border-bottom:1px solid #E5E7EB;
			     background:#EAF6FB;white-space:nowrap}
			  .num{text-align:right;font-variant-numeric:tabular-nums}
			  td{padding:5px 10px;border-bottom:1px solid #E5E7EB;
			     font-size:11px;color:#1F2937;vertical-align:middle}
			  tr:nth-child(even) td{background:#FAFAFA}
			  tr:hover td{background:#EAF6FB}
			  .bar-wrap{display:flex;align-items:center;gap:5px}
			  .bar-bg{width:60px;height:6px;background:#E5E7EB;border-radius:3px;flex-shrink:0}
			  .bar-fill{height:6px;border-radius:3px}
			  .mclr-ok{color:#08C792;font-weight:700}
			  .mclr-mid{color:#854f0b;font-weight:700}
			  .mclr-dn{color:#ED2939;font-weight:700}
			  .bullet{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:3px;vertical-align:middle}
			</style>
			<div class='wrap'><table>
			<thead><tr>
			  <th style='width:72px'>País</th>
			  <th style='width:80px'>MacroRegión</th>
			  <th style='width:78px'>Categoría</th>
			  <th style='width:82px'>Subcategoría</th>
			  <th style='width:110px'>Venta neta</th>
			  <th style='width:110px'>Órdenes AA</th>
			  <th style='width:110px'>Utilidad</th>
			  <th style='width:58px;text-align:right'>%Rate</th>
			  <th style='width:62px;text-align:right'>Ticket</th>
			  <th style='width:70px;text-align:right'>Margen</th>
			</tr></thead><tbody>"
			
			VAR _filas =
			    CONCATENATEX(
			        TOPN(
			            501, _data,
			            'DimRegion'[Country],      ASC,
			            'DimRegion'[MacroRegion],  ASC,
			            'DimProduct'[Category],    ASC,
			            'DimProduct'[Subcategory], ASC
			        ),
			
			        VAR _v  = [Venta Neta]
			        VAR _o  = [Ordenes]
			        VAR _u  = [Utilidad]
			        VAR _m  = [Margen]
			        VAR _r  = [Rate]
			        VAR _t  = [Ticket]
			
			        VAR _pctV = ROUND( DIVIDE( _v, _maxVenta )   * 100, 0 )
			        VAR _pctO = ROUND( DIVIDE( _o, _maxOrdenes ) * 100, 0 )
			        VAR _pctU = ROUND( DIVIDE( _u, _maxUtil )    * 100, 0 )
			
			        VAR _clrV = IF( _pctV >= 60, "#08C792", IF( _pctV >= 30, "#48B8DE", "#9CA3AF" ) )
			        VAR _clrO = IF( _pctO >= 60, "#4872A5", IF( _pctO >= 30, "#74B8DE", "#9CA3AF" ) )
			        VAR _clrU = IF( _pctU >= 60, "#08C792", IF( _pctU >= 30, "#F2C94C", "#ED2939" ) )
			
			        VAR _mCls =
			            IF( _m >= 0.30, "mclr-ok", IF( _m >= 0.15, "mclr-mid", "mclr-dn" ) )
			        VAR _bullet =
			            IF( _m >= 0.30, "#08C792", IF( _m >= 0.15, "#F2C94C", "#ED2939" ) )
			
			        RETURN
			            "<tr>" &
			                "<td style='font-weight:700'>" & 'DimRegion'[Country]     & "</td>" &
			                "<td style='color:#6B7280'>"   & 'DimRegion'[MacroRegion] & "</td>" &
			                "<td style='color:#6B7280'>"   & 'DimProduct'[Category]   & "</td>" &
			                "<td>"                         & 'DimProduct'[Subcategory] & "</td>" &
			
			                "<td>" &
			                    "<div class='bar-wrap'>" &
			                        "<div class='bar-bg'><div class='bar-fill' style='width:" & _pctV & "%;background:" & _clrV & "'></div></div>" &
			                        "<span style='font-size:10px;color:#1F2937'>$" & FORMAT( _v, "#,0" ) & "</span>" &
			                    "</div>" &
			                "</td>" &
			
			                "<td>" &
			                    "<div class='bar-wrap'>" &
			                        "<div class='bar-bg'><div class='bar-fill' style='width:" & _pctO & "%;background:" & _clrO & "'></div></div>" &
			                        "<span style='font-size:10px;color:#1F2937'>" & FORMAT( _o, "#,0" ) & "</span>" &
			                    "</div>" &
			                "</td>" &
			
			                "<td>" &
			                    "<div class='bar-wrap'>" &
			                        "<div class='bar-bg'><div class='bar-fill' style='width:" & _pctU & "%;background:" & _clrU & "'></div></div>" &
			                        "<span style='font-size:10px;color:#1F2937'>$" & FORMAT( _u, "#,0" ) & "</span>" &
			                    "</div>" &
			                "</td>" &
			
			                "<td class='num' style='color:#6B7280'>" & FORMAT( _r, "0.0%" ) & "</td>" &
			                "<td class='num' style='color:#6B7280'>$" & FORMAT( _t, "#,0" ) & "</td>" &
			
			                "<td class='num'>" &
			                    "<span class='bullet' style='background:" & _bullet & "'></span>" &
			                    "<span class='" & _mCls & "'>" & FORMAT( _m, "0.0%" ) & "</span>" &
			                "</td>" &
			            "</tr>",
			        "",
			        'DimRegion'[Country],      ASC,
			        'DimRegion'[MacroRegion],  ASC,
			        'DimProduct'[Category],    ASC,
			        'DimProduct'[Subcategory], ASC
			    )
			
			RETURN _html_inicio & _filas & "</tbody></table></div>"
		lineageTag: 03f79392-3e47-4520-ad2a-054c5d0bd24b

	partition Medida = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_ResultType = Table

