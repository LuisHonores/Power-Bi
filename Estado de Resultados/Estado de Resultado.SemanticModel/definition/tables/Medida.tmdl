table Medida
	lineageTag: 1c6d8d68-d295-4807-9c7f-0286da575e57

	measure 2024_ = CALCULATE (  SUM(tablon[Valor]),Dim_Calendar[Year]=2024)
		lineageTag: 8db1a876-2f23-4f40-aa5d-c6ac46449d12

		formatStringDefinition =
				VAR _CurrentValue =
				   ABS( SELECTEDMEASURE())
				VAR _NumberFormat =
				    SWITCH (
				        TRUE (),
				        _CurrentValue <= 1E3, "#,0.",
				        _CurrentValue <= 1E4, "#,0,.00 K",
				        _CurrentValue <= 1E5, "#,0,.0 K",
				        _CurrentValue <= 1E6, "#,0,. K",
				        _CurrentValue <= 1E7, "#,0,,.00 MM",
				        _CurrentValue <= 1E8, "#,0,,.0 MM",
				        _CurrentValue <= 1E9, "#,0,,. MM"
				    )
				VAR _FormatString =
				    _NumberFormat & " Avg. Views / Video"
				RETURN
				 _NumberFormat

	measure 2023_ = CALCULATE (  SUM(tablon[Valor]),Dim_Calendar[Year]=2023)
