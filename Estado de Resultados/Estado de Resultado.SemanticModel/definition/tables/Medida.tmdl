			  ISINSCOPE('Dimension'[GRUPO_1]),
			  [2023_],
			
			 SWITCH( 
			    SELECTEDVALUE('Dimension'[GRUPO_0]),
			    "Ingresos" , [Ingreso],
			    "Costo de Ventas", [Costo de ventas],
			    "Utilidad Bruta",[Ganancia],
			    "Utilidad Operativa",[Ganancia Operativa V2],
			    "Utilidad antes de Impuestos",[Ganancia Antes de Impuesto V2],
			    "Utilidad Neta del Ejercicio",[Ganancia Neta]
			 ))
			
			```
