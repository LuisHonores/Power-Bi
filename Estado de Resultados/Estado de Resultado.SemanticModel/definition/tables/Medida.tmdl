	measure VAR_Barras = ```
			
			 IF (ISINSCOPE('Dimension'[GRUPO_1]),
			 ABS( [2024_])  - ABS( [2023_]),BLANK())
			```
		lineageTag: 9789ac06-bfe7-4ba7-95c1-2b1e1fac8018

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure VAR_% = DIVIDE(( [2024_] - [2023_]),[2023_])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: abc54a3a-fbea-4f76-8961-84d57cc8ba8c

	measure GananciaBruta = ```
			
			
			CALCULATE( [2023_] ,'Dimension'[GRUPO_0] = "Ingresos",REMOVEFILTERS())
			
			
			```
		formatString: 0
		displayFolder: 01_2023
		lineageTag: 13b4f62a-6633-4bf2-88af-a8438bb708b4

	measure Var_Val_Financieros = ```
			
