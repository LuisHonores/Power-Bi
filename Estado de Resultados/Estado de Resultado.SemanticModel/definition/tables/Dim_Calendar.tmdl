	partition Dim_Calendar = calculated
		mode: import
		source = ```
				
				  ADDCOLUMNS ( 
				    CALENDAR ( DATE ( 2021,01,01),DATE ( 2024,12,31)),
				   "Year", YEAR([Date]), 
				    "MonthNo", MONTH([Date]), 
				    "Month", FORMAT([Date],"mmm"),
				    "Quarter", FORMAT([Date],"QQ"),
				    "YearMonth", FORMAT([Date],"YYYY-MM"), 
				    "WeekdayNo", WEEKDAY([Date],2), //1-Sun..Sat, 2-Mon..Sat
				    "Weekday", FORMAT([Date],"ddd") )
				```

	annotation PBI_Id = 04e53af838674c64b9c25b3752106dcb

